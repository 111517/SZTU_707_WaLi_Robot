#!/usr/bin/env python3
"""
go2_http_server.py — Go2 机器狗 HTTP 控制接口（v2 重写版）

    提供 RESTful API 和飞书 Webhook 双通道控制，覆盖 Go2 全部运动控制能力。
    支持基础动作、高级组合（跟随、巡航）、相机拍照/视频流。
    
    飞书通道：允许飞书私聊和群聊中的用户通过 HTTP API 控制机器狗。

启动（ssh 到 Unitree R1 / Go2 机载电脑执行）：
    source /opt/ros/foxy/setup.bash
    source ~/unitree_ros2/cyclonedds_ws/install/setup.bash
    export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
    export CYCLONEDDS_URI="file://$HOME/unitree_ros2/cyclonedds_ws/src/cyclonedds.xml"
    python3 go2_http_server.py [--port 8001] [--host 0.0.0.0]

API 接口：
    GET  /health              健康检查
    GET  /status              全部状态（模式/电池/定位/足力/障碍物）
    
    POST /stand               站立
    POST /sit                 坐下
    POST /lie                 趴下
    POST /stop                停止运动
    POST /recovery            恢复站立（自动故障处理）
    POST /damping             进入阻尼模式（卸力保护）
    POST /emergency_stop      紧急停止 → 阻尼模式
    
    POST /walk                速度行走  {"vx":0.3, "vy":0, "vyaw":0}
    POST /turn                原地转向  {"vyaw":0.5}
    POST /move                复合移动  {"vx":0.3, "vy":0, "vyaw":0.1}
    POST /jump                跳跃      {"height":0.3}
    POST /advance             前进指定距离  {"distance":1.0, "speed":0.3}
    POST /move_to             移动到坐标  {"x":1.0, "y":0.5}
    
    POST /action              表演动作  {"name":"hello"} (hello|dance|heart|stretch|...)
    POST /gait                切换步态  {"name":"trot"} (trot|run|walk|...)
    POST /speed_level         速度挡位  {"level":2}
    POST /pose                姿态控制  {"body_height":0.25}
    
    POST /photo               拍一张照片（返回图片）
    GET  /photo               获取最新照片
    GET  /stream              MJPEG 视频流
    
    POST /follow              跟随模式  {"target":"auto"} — 自动跟随最近物体
    POST /cruise              定位巡航  {"waypoints":[[1,0],[0,1]], "speed":0.3}
    POST /patrol              自动巡逻  {"radius":2.0, "speed":0.3}
    
    POST /feishu_webhook      飞书 Webhook 入口

飞书控制指令（群聊/私聊）：
    /stand    站起来
    /sit      坐下
    /lie      趴下
    /stop     停下
    /hello    打招呼
    /dance    跳舞
    /walk     往前走（默认 0.3m/s）
    /back     往后退
    /left     左转
    /right    右转
    /jump     跳跃
    /status   看状态
    /photo    拍照
    /follow   跟随模式
    /cruise   巡航
"""
import os
import sys
import time
import json
import math
import threading
import argparse
import logging
import struct
import io
import base64
from pathlib import Path
from datetime import datetime

# Flask
from flask import Flask, request, jsonify, Response, send_file

# ROS2
import rclpy
from rclpy.node import Node
from unitree_api.msg import Request as ApiRequest, Response as ApiResponse
from unitree_go.msg import SportModeState, LowState, WirelessController

# 相机（可选，无相机环境依旧能启动）
CV2_AVAILABLE = False
try:
    import cv2
    CV2_AVAILABLE = True
except ImportError:
    pass

# ============================================================

# ============================================
# Unitree Go2 Python SDK 配置文件
# ============================================
# 使用方式：
#   1. 复制本文件为 .env（如果不存在）
#   2. 根据实际环境修改参数
#   3. 测试程序通过 python-dotenv 自动加载
# ============================================

# ---- 网络配置 ----
# Go2 直连的以太网卡名称（默认 eth0）
NETWORK_INTERFACE=eth0

# CycloneDDS 配置路径
CYCLONEDDS_CONFIG_PATH=/home/unitree/unitree_ros2/cyclonedds_ws/src/cyclonedds.xml

# 机器人 IP（默认直连地址）
ROBOT_IP=192.168.123.161

# 本机 IP
LOCAL_IP=192.168.123.99

# ---- ROS2 配置 ----
# ROS2 版本 (foxy 或 humble)
ROS2_DISTRO=humble

# RMW 实现
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# ROS2 安装路径
ROS2_SETUP_PATH=/opt/ros/humble/setup.bash

# Unitree SDK 安装路径
UNITREE_WS_SETUP_PATH=/home/unitree/unitree_ros2/cyclonedds_ws/install/setup.bash

# ---- 机器人控制参数 ----
# 默认移动速度 (m/s)
DEFAULT_VX=0.3
DEFAULT_VY=0.0
DEFAULT_VYAW=0.3

# PID 参数（底层控制用）
KP=60.0
KD=5.0

# 默认抬腿高度 (m)
FOOT_RAISE_HEIGHT=0.09

# 默认机体高度 (m)
BODY_HEIGHT=0.32

# ---- 传感器 ----
# 激光雷达话题
LIDAR_CLOUD_TOPIC=/utlidar/cloud
LIDAR_CLOUD_DESKEWED_TOPIC=/utlidar/cloud_deskewed
LIDAR_IMU_TOPIC=/utlidar/imu

# ---- 测试参数 ----
# 测试持续时间（秒）
TEST_DURATION=10

# 日志目录
LOG_DIR=/home/unitree/unitree_ros2/analysis/logs